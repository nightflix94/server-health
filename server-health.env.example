# Telegram settings (required)
TELEGRAM_BOT_TOKEN=123456789:replace_with_your_bot_token
TELEGRAM_CHAT_ID=replace_with_your_chat_id

# Send a routine report every hour. Checks still happen every five minutes.
REPORT_INTERVAL_SECONDS=3600

# Repeat an ongoing alert no more than once every 30 minutes.
ALERT_COOLDOWN_SECONDS=1800

# Alert thresholds
CPU_THRESHOLD_PERCENT=90
MEMORY_THRESHOLD_PERCENT=90
DISK_THRESHOLD_PERCENT=85

# Filesystem to monitor and Telegram request timeout
DISK_PATH=/
CURL_TIMEOUT_SECONDS=15

